@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Python3 COMPONENTS Development)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/DEFwTargets.cmake")

set_and_check(DEFW_SWIG_TYPEMAP_DIR
	"${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/defw/swig/typemaps")
set(DEFW_PYTHON_INSTALL_DIR
	"${PACKAGE_PREFIX_DIR}/@DEFW_PYTHON_INSTALL_DIR@")

check_required_components(DEFw)
